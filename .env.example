# Copy to .env.local for `npm run dev`. In production, set these in Vercel
# (Project Settings -> Environment Variables). Never prefix with VITE_: that
# would ship the value to the browser.

# Required. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model IDs; defaults are in server/gemini.ts.
# Set GEMINI_FALLBACK_MODEL to an empty value to disable the fallback.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional. minimal | low | medium | high. Lower is faster; leave unset for the model default.
# GEMINI_THINKING_LEVEL=low

# Optional. Extra origins allowed to call /api/generate (comma-separated),
# e.g. a custom domain served through a proxy. The deployment's own host is always allowed.
# ALLOWED_ORIGINS=https://example.com

# Optional. Daily AI budget (Pacific-time day) across all users, and per IP.
# Keep DAILY_AI_LIMIT a little under your Gemini requests-per-day limit.
# DAILY_AI_LIMIT=18
# PER_IP_DAILY_AI_LIMIT=5

# Optional locally, required in production for the daily budget, the shared
# question bank and rooms. Set automatically by Vercel's Upstash/KV integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
